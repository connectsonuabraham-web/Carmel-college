{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/health",                "dest": "/api/health.js" },
    { "src": "/api/webhook/call",          "dest": "/api/webhook/call.js" },
    { "src": "/api/webhook/calls",         "dest": "/api/webhook/calls.js" },
    { "src": "/api/sarvam/(.*)",           "dest": "/api/sarvam/[...path].js" },
    { "src": "/api/campaigns/(.*)",        "dest": "/api/campaigns/[...path].js" },
    { "src": "/api/boards/(.*)",           "dest": "/api/boards/[...path].js" },
    { "src": "/(.*)",                      "dest": "/dist/$1" }
  ]
}
